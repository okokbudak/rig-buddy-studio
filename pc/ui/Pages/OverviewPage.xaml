<UserControl x:Class="RigBuddy.Ui.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Margin="14,12,6,14">
      <TextBlock x:Name="Title" Style="{StaticResource H1}"/>
      <TextBlock x:Name="GameLine" Style="{StaticResource Dim}" Margin="0,0,0,12"/>

      <UniformGrid Rows="1" Margin="0,0,0,4">
        <Border Style="{StaticResource Panel}"><StackPanel>
          <TextBlock x:Name="SumTelemLabel" Style="{StaticResource Caps}"/>
          <TextBlock x:Name="SumTelem" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/>
          <TextBlock x:Name="SumTelemSub" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Cyan}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Panel}"><StackPanel>
          <TextBlock x:Name="SumPhoneLabel" Style="{StaticResource Caps}"/>
          <TextBlock x:Name="SumPhone" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/>
          <TextBlock x:Name="SumPhoneSub" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Cyan}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Panel}"><StackPanel>
          <TextBlock x:Name="SumSysLabel" Style="{StaticResource Caps}"/>
          <TextBlock x:Name="SumSys" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
          <ProgressBar x:Name="SumSysBar" Maximum="100" Margin="0,8,0,0" Foreground="{DynamicResource Accent}"/>
        </StackPanel></Border>
      </UniformGrid>

      <!-- the telemetry service: where phones connect and the small services it is made of -->
      <TextBlock x:Name="SvcTitle" Style="{StaticResource Caps}" Margin="0,10,0,6"/>
      <Border Style="{StaticResource Panel}">
        <Grid>
          <!-- the buttons on top, wrapping in a narrow window; the address, the app link and the QR code use the full width below -->
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="1">
            <TextBlock x:Name="Detail" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock x:Name="AddressLabel" Style="{StaticResource Caps}"/>
            <TextBlock x:Name="Address" Style="{StaticResource Mono}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Cyan}" Margin="0,2,0,0"/>
            <TextBlock x:Name="Pairing" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
            <StackPanel x:Name="AppRow" Margin="0,12,0,0" Visibility="Collapsed">
              <TextBlock x:Name="AppLabel" Style="{StaticResource Caps}"/>
              <TextBlock x:Name="AppUrl" Style="{StaticResource Mono}" FontSize="14" Foreground="{DynamicResource Cyan}" Margin="0,2,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="AppHint" Style="{StaticResource Dim}" Margin="0,2,0,0" TextWrapping="Wrap"/>
              <!-- scan with the phone's camera: opens the download page -->
              <Image x:Name="AppQr" Width="144" Height="144" HorizontalAlignment="Left" Margin="0,8,0,0"
                     RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
            </StackPanel>
          </StackPanel>
          <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <Button x:Name="CopyButton" Click="OnCopy" Margin="0,0,8,6"/>
            <Button x:Name="CopyAppButton" Click="OnCopyApp" Margin="0,0,8,6"/>
            <Button x:Name="LogsButton" Click="OnLogs" Margin="0,0,8,6"/>
            <Button x:Name="ExitButton" Style="{StaticResource Danger}" Click="OnExit" Margin="0,0,0,6"/>
          </WrapPanel>
        </Grid>
      </Border>
      <ItemsControl x:Name="Services">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Panel}" Width="228" Padding="10,8" BorderThickness="2,1,1,1" BorderBrush="{DynamicResource Line}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Rectangle Width="8" Height="8" RadiusX="1" RadiusY="1" Fill="{Binding Dot}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding State}" Style="{StaticResource Caps}" Foreground="{Binding Dot}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Tag="{Binding Name}" Click="OnRestart" Style="{StaticResource DeviceButton}" Width="26" MinHeight="24" Margin="6,0,0,0">
                  <!-- the refresh mark drawn, not from the icon font (it showed as an empty box) -->
                  <Path Data="{StaticResource RefreshGeometry}" Width="13" Height="13" Stretch="Uniform"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>
</UserControl>
