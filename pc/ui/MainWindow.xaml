<Window x:Class="RigBuddy.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rig Buddy Studio" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Bg}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>

    <!-- top bar: product, live state of telemetry -->
    <Border Grid.Row="0" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Margin="14,0">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="RIG BUDDY STUDIO" FontWeight="Bold" FontSize="13"/>
          <TextBlock x:Name="Version" Style="{StaticResource Mono}" Foreground="{DynamicResource Text2}" Margin="10,1,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Ellipse x:Name="TelemDot" Width="8" Height="8" Margin="0,0,6,0"/>
          <TextBlock x:Name="TelemText" Style="{StaticResource Caps}" Foreground="{DynamicResource Text1}" Margin="0,0,22,0"/>
          <TextBlock x:Name="GameText" Style="{StaticResource Mono}" Foreground="{DynamicResource Cyan}" Margin="0,0,16,0"/>
          <Button x:Name="InspectorButton" Click="OnInspector" MinHeight="22" Padding="10,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

      <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,10,0,10">
            <TextBlock x:Name="GroupHome" Style="{StaticResource Caps}" Margin="16,6,0,6"/>
            <RadioButton x:Name="NavOverview" Style="{StaticResource Nav}" IsChecked="True" GroupName="nav" Checked="OnNav"/>
            <TextBlock x:Name="GroupSys" Style="{StaticResource Caps}" Margin="16,16,0,6"/>
            <RadioButton x:Name="NavSound" Style="{StaticResource Nav}" GroupName="nav" Checked="OnNav"/>
            <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" GroupName="nav" Checked="OnNav"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border x:Name="InspectorHost" Grid.Column="2" Width="316" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0"/>

      <DockPanel Grid.Column="1">
        <Border x:Name="Banner" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource Card}" BorderThickness="0,0,0,2" BorderBrush="{DynamicResource Warn}" Padding="16,8,12,8">
          <DockPanel>
            <Button x:Name="BannerButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Margin="12,0,0,0" Click="OnBanner"/>
            <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <ContentControl x:Name="Host"/>
      </DockPanel>
    </Grid>

    <!-- bottom rail: state of the program itself -->
    <Border Grid.Row="2" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
      <DockPanel Margin="14,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0"/>
          <TextBlock x:Name="StatusText" Style="{StaticResource Mono}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
          <TextBlock x:Name="PerfText" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Text2}" Margin="18,0,0,0"/>
          <TextBlock x:Name="ClientsText" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Text2}" Margin="18,0,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
